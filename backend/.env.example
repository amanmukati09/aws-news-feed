# ── App ─────────────────────────────────────────────
APP_ENV=local
CACHE_TTL_SECONDS=900
FEED_URLS=https://aws.amazon.com/about-aws/whats-new/recent/feed/,https://aws.amazon.com/blogs/aws/feed/,https://aws.amazon.com/blogs/machine-learning/feed/,https://aws.amazon.com/blogs/compute/feed/
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# ── LLM provider switch ─────────────────────────────
# local | bedrock
LLM_PROVIDER=local

# ── Local provider ──────────────────────────────────
# mock | groq
LOCAL_LLM_MODE=mock

# Groq (OpenAI-compatible). Required only when LOCAL_LLM_MODE=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# ── AWS Bedrock (unused locally; EC2 fills these) ───
# Credentials come from the IAM role on EC2 — no keys here.
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_SEARCH_MODEL_ID=amazon.nova-lite-v1:0

# ── Chat tuning ─────────────────────────────────────
CHAT_TOP_K=6
CHAT_MAX_TOKENS=600
CHAT_TEMPERATURE=0.2
